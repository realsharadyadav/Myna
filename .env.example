# Myna environment configuration
# Copy this file to .env and fill in your real API keys.
# .env is gitignored — never commit real keys.

# LLM Vision providers — set whichever you have.
# Set the default model in the admin panel; it is saved in the DB.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Web search grounding (app/web_search.py) — for trending / weather-based
# suggestions later. Optional: falls back to free/keyless DuckDuckGo.
EXA_API_KEY=

# Database (optional — SQLite file is used if unset):
#   MYNA_DATABASE_URL is checked first, then DATABASE_URL, then falls back to SQLite.
#   DATABASE_URL is auto-injected by Render/Heroku — only set MYNA_DATABASE_URL if
#   you want a DIFFERENT database than the platform's default.
# MYNA_DATABASE_URL=postgresql://user:pass@host:5432/myna
# DATABASE_URL=sqlite:///./myna.db

# Uploads
# UPLOAD_DIR=./uploads
